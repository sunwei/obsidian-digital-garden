{
  "schema": 1,
  "family": {
    "id": "quartz",
    "name": "Quartz",
    "targets": [
      "folder"
    ],
    "defaultVariant": "quartz",
    "engine": {
      "foundry": ">=26.5.0 <27.0.0",
      "base": "^2.4.79"
    }
  },
  "variants": [
    {
      "id": "quartz",
      "name": "Quartz",
      "default": true,
      "css": "static/css/variants/quartz.css",
      "tier": "professional",
      "kinds": [
        "wiki",
        "docs",
        "digital-garden"
      ],
      "tags": [
        "beercss",
        "wiki",
        "beer-source",
        "seed:#3366cc"
      ]
    }
  ],
  "capabilities": {
    "darkmode": true,
    "search": true,
    "i18n": true,
    "math": true,
    "mermaid": true,
    "explorer": true,
    "graph": true,
    "clipboard": true,
    "toc": true,
    "breadcrumbs": true,
    "readerMode": true,
    "subscribe": true,
    "commerce": true
  },
  "capabilityOverrides": {
    "search": {
      "variant": "inline",
      "trigger": "sidebar",
      "content": true,
      "cjk": true
    },
    "toc": {
      "variant": "interactive"
    }
  },
  "customParams": {
    "logo": "favicon.svg",
    "favicon": "favicon.svg",
    "navLinks": [
      {
        "title": "Website",
        "url": "https://mdfriday.com"
      },
      {
        "title": "Pricing",
        "url": "https://mdfriday.com/pricing/"
      },
      {
        "title": "Get started",
        "url": "/get-started/"
      }
    ]
  },
  "shortcodes": [
    "callout",
    "details",
    "tabs"
  ],
  "externalDeps": [],
  "author": {
    "id": "mdfriday",
    "name": "MDFriday",
    "official": true
  },
  "license": "MIT",
  "pack": {
    "exclude": [
      "fixtures/**",
      "showcase/**",
      "screenshots/**",
      "theme-dna.yaml",
      "*.md",
      "LICENSE"
    ]
  }
}
